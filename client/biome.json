{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": false },
  "files": {
    "includes": [
      "src/**/*.ts",
      "tests/**/*.ts",
      "scripts/**/*.ts",
      "docs-site/**/*.ts",
      "vite.config.ts",
      "biome.json",
      "!src/game/kitDifficulty.generated.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140
  },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "always", "trailingCommas": "es5" }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noExplicitAny": "error", "noEmptyBlockStatements": "error" },
      "style": { "noNonNullAssertion": "error" }
    }
  },
  "overrides": [{ "includes": ["tests/**"], "linter": { "rules": { "style": { "noNonNullAssertion": "off" } } } }],
  "assist": { "enabled": false }
}
